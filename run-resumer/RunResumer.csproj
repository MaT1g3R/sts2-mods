<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>RunResumer</AssemblyName>
    <RootNamespace>RunResumer</RootNamespace>
    <Version>1.2.0</Version>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);src/RunResumer.Core/**;tests/**</DefaultItemExcludes>
    <!-- Override with -p:Sts2GameDir=... or the STS2_GAME_DIR environment variable. -->
    <Sts2GameDir Condition="'$(Sts2GameDir)' == ''">$(STS2_GAME_DIR)</Sts2GameDir>
    <Sts2GameDir Condition="'$(Sts2GameDir)' == ''">$(HOME)/.steam/steam/steamapps/common/Slay the Spire 2</Sts2GameDir>
    <Sts2DataDir>$(Sts2GameDir)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/RunResumer.Loader/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(Sts2DataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src/RunResumer.Core/RunResumer.Core.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="false" />
  </ItemGroup>

  <PropertyGroup>
    <CoreOutDir>$(ProjectDir)src/RunResumer.Core/bin/$(Configuration)/net9.0/</CoreOutDir>
  </PropertyGroup>

  <Target Name="CopySidecarsToOutput" AfterTargets="Build">
    <Copy SourceFiles="$(CoreOutDir)RunResumer.Core.dll;$(CoreOutDir)Google.Protobuf.dll"
          DestinationFolder="$(OutputPath)" />
  </Target>

  <!-- dotnet build -c Release -p:DeployToMods=true -->
  <Target Name="DeployToMods" AfterTargets="CopySidecarsToOutput" Condition="'$(DeployToMods)' == 'true'">
    <PropertyGroup>
      <ModDestDir>$(Sts2GameDir)/mods/$(AssemblyName)</ModDestDir>
    </PropertyGroup>
    <MakeDir Directories="$(ModDestDir)" />
    <Copy SourceFiles="$(TargetPath);$(OutputPath)RunResumer.Core.dll;$(OutputPath)Google.Protobuf.dll"
          DestinationFolder="$(ModDestDir)" />
    <Copy SourceFiles="$(ProjectDir)$(AssemblyName).json"
          DestinationFolder="$(ModDestDir)"
          Condition="Exists('$(ProjectDir)$(AssemblyName).json')" />
    <Copy SourceFiles="$(ProjectDir)$(AssemblyName).pck"
          DestinationFolder="$(ModDestDir)"
          Condition="Exists('$(ProjectDir)$(AssemblyName).pck')" />
    <Message Importance="High" Text="Deployed $(AssemblyName) to $(ModDestDir)" />
  </Target>
</Project>
